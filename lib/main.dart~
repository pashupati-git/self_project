class MyApp extends ConsumerWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {

    final theme = ref.watch(appThemeProvider);
    return MaterialApp(
      title: 'Riverpod 2.0 Demo',
      theme: theme,
      home:HomePage(),

    );
  }
}
