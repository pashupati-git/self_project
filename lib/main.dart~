import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

import 'package:login/screens/home_page.dart';




void main() {
  runApp(
    // ProviderScope is required at the root to enable Riverpod
    ProviderScope(
      child: MyApp(),
    ),
  );
}

