// ============================================================================
// 2. NOTIFIER PROVIDER - Mutable state (Riverpod 3.0 style)
// ============================================================================

class Counter extends Notifier<int> {
  @override
  int build() {
    return 0;
  }

  void increment() {
    state++;
  }

  void decrement() {
    state--;
  }

  void reset() {
    state = 0;
  }
}

final counterProvider = NotifierProvider<Counter, int>(Counter.new);

// ============================================================================
// 3. ASYNC NOTIFIER PROVIDER - For async operations
// ============================================================================

class UserData extends AsyncNotifier<Map<String, dynamic>> {
  @override
  Future<Map<String, dynamic>> build() async {
    await Future.delayed(Duration(seconds: 2));

    return {
      'name': 'John Doe',
      'email': 'john@example.com',
      'age': 30,
    };
  }

  Future<void> refresh() async {
    state = const AsyncValue.loading();

    await Future.delayed(Duration(seconds: 1));

    state = AsyncValue.data({
      'name': 'John Doe (Refreshed)',
      'email': 'john@example.com',
      'age': 30,
    });
  }
}

final userDataProvider = AsyncNotifierProvider<UserData, Map<String, dynamic>>(UserData.new);

// ============================================================================
// 4. STREAM PROVIDER - For continuous data streams
// ============================================================================

final timerProvider = StreamProvider<int>((ref) {
  return Stream.periodic(
    Duration(seconds: 1),
        (count) => count,
  );
});

// ============================================================================
// 5. FAMILY NOTIFIER - Fixed version without AutoDispose
// ============================================================================

class UserById extends FamilyNotifier<String, int> {
  @override
  String build(int userId) {
    // In family notifiers, the parameter comes through build()
    _loadUser(userId);
    return 'Loading user $userId...';
  }

  Future<void> _loadUser(int id) async {
    await Future.delayed(Duration(seconds: 1));
    state = 'User data for ID: $id';
  }
}

final userByIdProvider = NotifierProvider.family<UserById, String, int>(UserById.new);

