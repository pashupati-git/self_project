// ============================================================================
// 1. SIMPLE PROVIDER - Immutable value provider
// Use case: Configuration values, constants, computed values
// ============================================================================
final appThemeProvider = Provider<ThemeData>((ref) {
  // Standard Provider - returns immutable value
  return ThemeData(
    primarySwatch: Colors.blue,
    brightness: Brightness.light,
  );
});

// ============================================================================
// 2. NOTIFIER PROVIDER - Mutable state with methods (Riverpod 3.0 style)
// Use case: Simple state with business logic
// This is the new way in Riverpod 3.0 (replaces StateProvider)
// ============================================================================

// Step 1: Create the Notifier class
class Counter extends Notifier<int> {
  // Notifier<int> means this manages an int state

  @override
  int build() {
    // build() returns the initial state
    return 0;
  }

  // Methods to modify state
  void increment() {
    state++; // state is from Notifier<int>
  }

  void decrement() {
    state--;
  }

  void reset() {
    state = 0;
  }
}

// Step 2: Create the provider
final counterProvider = NotifierProvider<Counter, int>(() {
  // NotifierProvider<Counter, int>
  // Counter = the notifier class
  // int = the state type
  return Counter();
});

// ============================================================================
// 3. ASYNC NOTIFIER PROVIDER - For async operations
// Use case: API calls, async initialization
// ============================================================================

class UserData extends AsyncNotifier<Map<String, dynamic>> {
  // AsyncNotifier<T> for async state management

  @override
  Future<Map<String, dynamic>> build() async {
    // build() returns Future<T> for initial async load
    await Future.delayed(Duration(seconds: 2));

    return {
      'name': 'John Doe',
      'email': 'john@example.com',
      'age': 30,
    };
  }

  // Async method to refresh data
  Future<void> refresh() async {
    state = const AsyncValue.loading();

    await Future.delayed(Duration(seconds: 1));

    state = AsyncValue.data({
      'name': 'John Doe (Refreshed)',
      'email': 'john@example.com',
      'age': 30,
    });
  }
}

final userDataProvider = AsyncNotifierProvider<UserData, Map<String, dynamic>>(() {
  return UserData();
});

// ============================================================================
// 4. STREAM PROVIDER - For continuous data streams
// Use case: Real-time updates, timers, WebSocket data
// ============================================================================

final timerProvider = StreamProvider<int>((ref) {
  // StreamProvider automatically handles stream lifecycle
  return Stream.periodic(
    Duration(seconds: 1),
        (count) => count,
  );
});

// ============================================================================
// 5. FAMILY NOTIFIER - Notifier with parameters
// Use case: Multiple instances with different arguments
// ============================================================================

class UserById extends Notifier<String> {
  // We'll receive userId through arg property
  late int userId;

  @override
  String build() {
    // For family providers, parameters come through provider.call()
    return 'Loading user...';
  }

  Future<void> loadUser(int id) async {
    userId = id;
    state = 'Loading user $id...';

    await Future.delayed(Duration(seconds: 1));

    state = 'User data for ID: $id';
  }
}

// Family provider - accepts parameters
final userByIdProvider = NotifierProvider.family<UserById, String, int>((ref, userId) {
  final notifier = UserById();
  notifier.loadUser(userId);
  return notifier;
});

// ============================================================================
// 6. AUTO DISPOSE NOTIFIER - Automatically cleanup when not used
// Use case: Temporary data, search results, filters
// ============================================================================

class SearchQuery extends AutoDisposeNotifier<String> {
  // AutoDisposeNotifier automatically disposes when no longer watched

  @override
  String build() {
    // Auto-dispose happens when all listeners are removed
    return '';
  }

  void updateQuery(String query) {
    state = query;
  }

  void clear() {
    state = '';
  }
}

final searchQueryProvider = AutoDisposeNotifierProvider<SearchQuery, String>(() {
  return SearchQuery();
});

// Auto-dispose async notifier for search results
class SearchResults extends AutoDisposeAsyncNotifier<List<String>> {
  @override
  Future<List<String>> build() async {
    // Watch the search query
    final query = ref.watch(searchQueryProvider);

    if (query.isEmpty) {
      return [];
    }

    // Simulate API call
    await Future.delayed(Duration(milliseconds: 500));

    return [
      'Result 1 for $query',
      'Result 2 for $query',
      'Result 3 for $query',
    ];
  }
}

final searchResultsProvider = AutoDisposeAsyncNotifierProvider<SearchResults, List<String>>(() {
  return SearchResults();
});

